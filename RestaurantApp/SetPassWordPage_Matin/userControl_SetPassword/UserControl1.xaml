<UserControl x:Class="RestaurantApp.SetPassWordPage_Matin.userControl_SetPassword.txtBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantApp.SetPassWordPage_Matin.userControl_SetPassword"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="TxtBox_M" Background="Transparent" BorderBrush="AliceBlue" VerticalContentAlignment="Center" BorderThickness="2" TextChanged="TextChanged" />
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12px"  x:Name="txtB" Margin="5,0,0,0" Panel.ZIndex="-1"/>
        <Button x:Name="Button_m" Grid.Column="1" BorderBrush="Transparent" Click="SHOWHide">
            <Button.Content>
                <ContentPresenter>
                    <ContentPresenter.Content>
                        <Image x:Name="ButtonImage" Source="/SetPassWordPage_Matin/images/hide.png" Stretch="Uniform"/>
                    </ContentPresenter.Content>
                </ContentPresenter>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
