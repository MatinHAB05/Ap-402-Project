<Window x:Class="RestaurantApp.CommentSection_CustomerPanel_Matin.CommentSection_CustomerPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantApp.CommentSection_CustomerPanel_Matin"
        mc:Ignorable="d"
        Title="CommentSection_CustomerPanel" Height="600" Width="1320" Closing ="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Button  Click="BackPage" Grid.Column="0" Grid.Row="0" Background="#123456" HorizontalAlignment="Left" Foreground="DarkBlue" Height="30" Width="70">
                <Image Source="/matinImages_matin/back.png" />
            </Button>
        </Grid>
        <Grid Grid.Row="1">

            <Border BorderBrush="Black" BorderThickness="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add New" Margin="15,5,5,5" Width="80" FontSize="18" Background="SkyBlue" Click="ADDbbb"/>
                    <Button Content="Reply" Margin="15,5,5,5" Width="60" FontSize="18" Background="SkyBlue" Click="REPbbb"/>
                    <Button Content="Edit" Margin="15,5,5,5" Width="50" FontSize="18" Background="SkyBlue" Click="EDITbbb"/>

                    <TextBox x:Name="TitleComment" Width="100"  Margin="15,5,5,5" VerticalContentAlignment="Center" ToolTip="Comment Title"/>
                    <TextBox x:Name="ContentComment" Width="300"  Margin="15,5,5,5"  VerticalContentAlignment="Center" ToolTip="Comment Content"/>
                    <Button Content="Remove" Margin="15,5,5,5" Width="70" FontSize="18" Background="SkyBlue" Click="REmoveBBB"/>
                    <TextBox x:Name="PointTTTT" Width="100"  Background="Black" Foreground="White" Margin="15,5,5,5"  VerticalContentAlignment="Center" ToolTip="Food Point"/>
                    <Button Content="Save Point" Margin="15,5,5,5" Width="100" FontSize="18" Background="Gray" Click="SAVEpoint"/>
                    <Button Content="Delete Point" Margin="15,5,5,5" Width="105" FontSize="18" Background="Goldenrod" Click="DelPPP"/>

                    <Button Content="Free Selection" Margin="15,5,5,5" Width="130" FontSize="18" Background="HotPink" Click="FreeSel"/>



                </StackPanel>
            </Border>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>

            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TreeView x:Name="CommentTreeView" SelectedItemChanged="CommentTreeView_SelectedItemChanged" Grid.ColumnSpan="3" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:CommentForNow}" ItemsSource="{Binding Reply}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="{Binding TitleUI}" FontWeight="Bold" />
                                <TextBlock Text="{Binding ContetnComment}" TextWrapping="Wrap" Margin="20,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <TextBlock Text="{Binding fffstingPoint}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding fffstingEDIT}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>


            </Grid>
            <Grid Grid.Column="1">
                <ScrollViewer />
            </Grid>


        </Grid>
    </Grid>
</Window>
