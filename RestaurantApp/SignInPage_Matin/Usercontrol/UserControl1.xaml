<UserControl x:Class="RestaurantApp.SignInPage_Matin.Usercontrol.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantApp.SignInPage_Matin.Usercontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Opacity="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="RecaVar" Grid.Column="0" Fill="#FFCC00"  Height="40"/>
        <Image Grid.Column="0" x:Name="ImageVAr" HorizontalAlignment="Left" VerticalAlignment="Center" Source="{Binding IMGSource}" Height="25" Stretch="Uniform" Width="{Binding XWidth}"  Margin="8"/>
        <TextBox x:Name="txtBox" Grid.Column="1" BorderBrush="AliceBlue" BorderThickness="2" FontSize="15" VerticalContentAlignment="Center"/>

    </Grid>
</UserControl>
