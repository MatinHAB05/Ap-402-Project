<Window x:Class="RestaurantApp.AddFood_Parham.AddFood.AddFood"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantApp.AddFood_Parham.AddFood"
        mc:Ignorable="d"
        Background="LightSkyBlue"
        Title="AddFood" Closing="Window_Closing" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Add a food" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="35"/>
        <TextBox  Grid.Row="1" Name="Category_Name" Background="White" Width="250" Height="40" />
        <TextBox  Grid.Row="2" Name="Food_Name" Background="White" Width="250" Height="40" />
        <TextBox  Grid.Row="3" Name="Price" Background="White" Width="250" Height="40" />
        <TextBox  Grid.Row="4" Name="Materials" Background="White" Width="250" Height="40" />
        <TextBox  Grid.Row="5" Name="Remaine_Number" Background="White" Width="250" Height="40" />
        <Button  Grid.Row="5" Margin="600,0,0,0" Width="100" Height="50" Content="Completed" Click="Complete_Click"/>
        <TextBlock  Grid.Row="1" Margin="-500,0,0,0" Background="LightSkyBlue" Width="100" Height="40" Text="Category Name"/>
        <TextBlock  Grid.Row="2" Margin="-500,0,0,0" Background="LightSkyBlue" Width="100" Height="20"  Text="Food Name"/>
        <TextBlock  Grid.Row="3" Margin="-500,0,0,0" Background="LightSkyBlue" Width="100" Height="20"  Text="Price"/>
        <TextBlock  Grid.Row="4" Margin="-500,0,0,0" Background="LightSkyBlue" Width="100" Height="20"  Text="Materials"/>
        <TextBlock  Grid.Row="4" Margin="510,0,0,0" Background="LightSkyBlue" Width="200" Height="20"  Text="- please put materials between ,"/>
        <TextBlock  Grid.Row="5" Margin="-500,0,0,0" Background="LightSkyBlue" Width="100" Height="20" Text="Remaine Number"/>
        <Button  Click="BackPage" Grid.Column="0" Grid.Row="0" Background="#123456" HorizontalAlignment="Left" Foreground="DarkBlue" Height="30" Width="70">
            <Image Source="/matinImages_matin/back.png" />
        </Button>
        <Button Grid.Row="1" Margin="600,0,0,0" Width="100" Height="40" Content="Pick an Image" Click="Image_Picked"/>
    </Grid>
</Window>
