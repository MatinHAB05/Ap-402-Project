<Window x:Class="MainProject.AdminPage_Parham.AdminPage.AdminPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainProject.AdminPage_Parham.AdminPage"
        mc:Ignorable="d"
        Title="AdminPage" Height="450" Width="800"
        Background="LightCyan" Closing="Window_Closing">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />

        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Background="LightBlue">
        </Border>
        <Button  Content="Log Out" Click="Logout"  Grid.Row="0" Background="Red" HorizontalAlignment="Left" Foreground="DarkBlue" Height="30" Width="70"/>

            <TextBlock Grid.Row="0" Text="Admin Page" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        <Button Grid.Row="1"
                x:Name="Restaurant_Registration"
                Content="Restaurant Registration"
                Margin="-620, 0 0 0"
                Background="LightCyan"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Height="30"
                Width="150"
                FontSize="12"
                Click="Restaurant_Registration_Click"/>
        <Button Grid.Row="1"
                x:Name="Search_on_Restaurants"
                Content="Search on Restaurants"
                Margin="0, 0 0 0"
                Background="LightCyan"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Height="30"
                Width="150"
                Click="Search_ON_Restaurants_Click"/>
        <Button Grid.Row="2"
                x:Name="Search_on_Complaints"
                Content="Search on Complaints"
                Margin="-620, 0 0 0"
                Background="LightCyan"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Height="30"
                Width="150"
                Click="Search_ON_Complaints_Click"/>
        <Button Grid.Row="2"
                x:Name="Last_Unread_Complaints"
                Content="Last Unread Complaints"
                Margin="0, 0 0 0"
                Background="LightCyan"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Height="30"
                Width="150"
                Click="Last_Unread_Complaints_Click"/>
        <Button Grid.Row="3"
                x:Name="Answer_Last_Unread_Complaints"
                Content="Answer to Last Unread Complaints"
                Margin="0, 0 0 0"
                Background="LightCyan"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Height="30"
                Width="190"
                Click="Answer_Last_Unread_Complaints_Click"/>
        <Button Grid.Row="6"
                x:Name="All_Complaints"
                Content="All Complaints"
                Margin="-620, 0 0 0"
                Background="LightCyan"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Height="30"
                Width="190"
                Click="All_Complaints_Click"/>
        <Image  Grid.Row ="1"  Margin="-370,0,0,0" Source="/AdminPage_Parham/images/retaurant4.jpg" Width="100" Height="100"/>
        <Image  Grid.Row ="1"  Margin="380,0,0,0" Source="/AdminPage_Parham/images/retaurant4.jpg" Width="40" Height="40"/>
        <Image  Grid.Row ="1"  Margin="300,0,0,0" Source="/AdminPage_Parham/images/magnifier.png" Width="40" Height="40"/>
        <Image  Grid.Row ="2"  Margin="-420,0,0,0" Source="/AdminPage_Parham/images/magnifier.png" Width="40" Height="40"/>
        <Image  Grid.Row ="2"  Margin="-320,0,0,0"  Source="/AdminPage_Parham/images/letter-symbol.png" Width="60" Height="60" />
        <Image  Grid.Row ="2"  Margin="300,0,0,0"  Source="/AdminPage_Parham/images/!-symbol.png" Width="40" Height="40" />
        <Image  Grid.Row ="2"  Margin="390,0,0,0"  Source="/AdminPage_Parham/images/letter-symbol.png" Width="60" Height="60" />
        <Image  Grid.Row ="3"  Margin="-360,0,0,0"  Source="/AdminPage_Parham/images/letter-symbol.png" Width="100" Height="100" />
        <Image  Grid.Row ="3"  Margin="290,0,0,0"  Source="/AdminPage_Parham/images/answer-symbol.png" Width="40" Height="40" />
        <Image  Grid.Row ="3"  Margin="390,0,0,0"  Source="/AdminPage_Parham/images/letter-symbol.png" Width="60" Height="60" />
    </Grid>
</Window>
