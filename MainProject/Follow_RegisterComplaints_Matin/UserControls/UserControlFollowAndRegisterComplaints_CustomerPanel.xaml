<UserControl x:Class="MainProject.Follow_RegisterComplaints_Matin.UserControls.UserControlFollowAndRegisterComplaints_CustomerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MainProject.Follow_RegisterComplaints_Matin.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding LabelContent}" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Width="148"  HorizontalAlignment="Center"
                   d:Content="LabelName" d:Foreground="Wheat" Margin="0,0,15,0"/>
            <TextBox  x:Name="txtBox" Height="{Binding HeightTxtBox}" FontSize="16" Width="600" BorderBrush="AliceBlue" BorderThickness="2"   d:Height="80" d:Width="600"/>
        </StackPanel>
    </Grid>
</UserControl>
