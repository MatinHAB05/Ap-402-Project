<UserControl x:Class="MainProject.Search_Restuant_PageADMIN_Matin.UserControls.searchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MainProject.Search_Restuant_PageADMIN_Matin.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800"
             >
    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="txtBoxSerach" VerticalContentAlignment="Center" BorderThickness="2" BorderBrush="AliceBlue" Background="#DCDCDC" Height="32" Width="128" PreviewMouseDown="txtBoxSerach_PreviewMouseLeftButtonDown" />
            <Image x:Name="imgD"  Source="/Search_Restuant_PageADMIN_Matin/Images/s1.jpg" Width="30" Height="40"/>
        </StackPanel>
    </Grid>
</UserControl>
