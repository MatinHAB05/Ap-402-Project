<Window x:Class="MainProject.Search_Restuant_PageADMIN_Matin.Search_Res_AdminPageForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainProject.Search_Restuant_PageADMIN_Matin"
        xmlns:USEcon="clr-namespace:MainProject.Search_Restuant_PageADMIN_Matin.UserControls"
        mc:Ignorable="d"
        Title="Search_Res_AdminPageForm" Height="824" Width="1500" Background="#FFF5EE" PreviewMouseDown="Window_MouseDown" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Border BorderThickness="2" Background="White" BorderBrush="LightGray" Margin="8,10,8,10">
                <StackPanel Margin="5,5,5,5">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Filters" FontSize="20" Foreground="Black"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Label Margin="15,0,0,0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Hyperlink Click="RemoveFilters" >Remove Filters</Hyperlink>
                        </Label>
                    </StackPanel>
                    <USEcon:searchBox x:Name="D"  Margin="5,15,5,5"/>
                    <USEcon:searchBox x:Name="D2"  Margin="5,5,5,15"/>

                    <StackPanel Orientation="Horizontal">
                        <Label Content="Min Points :" FontWeight="Bold" Margin="5,5,5,2" FontSize="15"/>
                        <Label x:Name="PointsLabel" Content="{Binding MinPointsSearch,UpdateSourceTrigger=PropertyChanged}"  VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Slider x:Name="sliderPoint"  Maximum="{Binding MaxPointsSearch,UpdateSourceTrigger=PropertyChanged}"  Minimum="0" LargeChange="0.5" TickPlacement="BottomRight" TickFrequency="0.1" Value="{Binding MinPointsSearch,  Mode=OneWayToSource , FallbackValue =0}" Margin="5,5,5,15" ValueChanged="sliderPoint_ValueChanged"/>


                    <StackPanel Orientation="Horizontal">
                        <Label Content="Max Points :" FontWeight="Bold" Margin="5,5,5,2" FontSize="15"/>
                        <Label x:Name="PointsLabel2" Content="{Binding MaxPointsSearch,UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Slider x:Name="sliderPoint2" Maximum="5" Minimum="{Binding MinPointsSearch,UpdateSourceTrigger=PropertyChanged}"   LargeChange="0.5" TickPlacement="BottomRight" TickFrequency="0.1" Value="{Binding MaxPointsSearch,  Mode=OneWayToSource , FallbackValue=5}"    Margin="5,5,5,15" ValueChanged="sliderPoint_ValueChanged"/>
                    <Label Content="Have an unanswered complaint?" Margin="0,0,0,0"/>
                    <RadioButton Content="Yes" x:Name="radioButton" GroupName="Complaints" Margin="0,0,0,3" />
                    <RadioButton Content="No" x:Name="radioButton2" GroupName="Complaints"  Margin="0,0,0,25"/>


                    <Button Content="Search" VerticalAlignment="Center" HorizontalAlignment="Center" Background="DeepSkyBlue" Foreground="White" FontSize="20" Width="100" Height="40"/>
                </StackPanel>



            </Border>



        </Grid>
        <ScrollViewer >
            <Border BorderThickness="2" Background="White" BorderBrush="LightGray" Margin="8,10,8,10">

                <Grid Grid.Column="0"  Margin="8,10,8,10">
                    <DataGrid x:Name="DataGridResault" IsReadOnly="True" />
                </Grid>
            </Border>

        </ScrollViewer>

    </Grid>
</Window> 
