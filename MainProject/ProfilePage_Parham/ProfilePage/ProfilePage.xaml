<Window x:Class="MainProject.ProfilePage_Parham.ProfilePage.ProfilePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainProject.ProfilePage_Parham.ProfilePage"
        mc:Ignorable="d"
        Background="LightSkyBlue"
        Title="ProfilePage" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Profile Page" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="35"/>
        <TextBlock Grid.Row="1" x:Name="Name" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="2" x:Name="LastName" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="3" x:Name="Phone" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="4" x:Name="UserName" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="5" x:Name="Email" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="6" x:Name="Address" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="7" x:Name="Gender" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Width="250" Height="30"/>
        <TextBlock Grid.Row="8" x:Name="CustomerType" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
        <Image Margin="300,0,0,0" Grid.Row="0" Source="/ProfilePage_Parham/images/User Symbol .png" Stretch="Fill" Width="60" Height="50"/>
        <Button Grid.Row="5" Margin="500,0,0,0" Content="Change" Background="White" Foreground="LightGray" BorderBrush="LightSkyBlue" Width="50" Height="40" Click="Change_Email_Click"/>
        <Button Grid.Row="6" Margin="500,0,0,0" Content="Change" Background="White" Foreground="LightGray" BorderBrush="LightSkyBlue" Width="50" Height="40" Click="Change_Address_Click"/>
        <Button Grid.Row="8" Margin="500,0,0,0" Content="Change" Background="White" Foreground="LightGray" BorderBrush="LightSkyBlue" Width="50" Height="40" Click="Change_CustomerType_Click"/>
    </Grid>
</Window>
