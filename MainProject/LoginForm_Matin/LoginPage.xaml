<Window x:Class="MainProject.LoginForm_Matin.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainProject.LoginForm_Matin"
        xmlns:UserCont111="clr-namespace:MainProject.LoginForm_Matin.userControl"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/LoginForm_Matin/images/background1.jpg" Stretch="Fill"/>
    </Window.Background>
    <Grid >
        
        <Grid.ColumnDefinitions >
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Background="Transparent" Margin="50,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition />
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                 <RowDefinition/>
                
            </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Titre" FontSize="50" HorizontalAlignment="Left"/>
                <UserCont111:UserControl1 Grid.Row="1" Content="UserName :"/>

                <UserCont111:UserControl1 Grid.Row="2" Content="PassWord :"/>
                <Label Grid.Row="3"  FontSize="25" HorizontalAlignment="Left">
                    <Hyperlink>
                        Create Acount
                    </Hyperlink>
                </Label>




                <!-- End Column1 -->
            </Grid>





    </Grid>
</Window>
