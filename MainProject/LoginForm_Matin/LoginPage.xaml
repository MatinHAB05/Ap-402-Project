<Window x:Class="MainProject.LoginForm_Matin.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainProject.LoginForm_Matin"
        xmlns:UserCont111="clr-namespace:MainProject.SetPassWordPage_Matin.userControl_SetPassword"

        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/LoginForm_Matin/images/res1.jpg" Stretch="Fill"/>

    </Window.Background>
    <Grid>
        <StackPanel Height="260" Width="500"  VerticalAlignment="Center" HorizontalAlignment="Center" Background="White">
            <Label Content="Username" FontSize="15"/>
            <UserCont111:txtBoxControl  x:Name="UserName" Height="19.96" Margin="5"/>
            <Label Content="Password" FontSize="15"/>
            <UserCont111:txtBoxControl  x:Name="PassWord" Height="19.96" Margin="5"/>
            <Button Foreground="WhiteSmoke" FontSize="18" Width="488"  Height="40" Margin="5,10,5,5" Click="LoginBut">
                <Button.Background>
                    <SolidColorBrush Color="#EE1B24"/>
                </Button.Background>
                <Button.Content>
                    <TextBlock FontWeight="Bold" Text="Login"/>
                </Button.Content>
            </Button>
            <Label Content="OR" HorizontalAlignment="Center" FontSize="12"/>
            <Button Foreground="WhiteSmoke" FontSize="18" Width="488"  Height="40" Margin="5" Click="SignBut">
                <Button.Background>
                    <SolidColorBrush Color="#3B82F6"/>
                </Button.Background>
                <Button.Content>
                    <TextBlock FontWeight="Bold" Text="Sigin"/>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Window>