<Window x:Class="MainProject.SignInPage_Matin.SignInForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainProject.SignInPage_Matin"
        xmlns:UserOb="clr-namespace:MainProject.SignInPage_Matin.Usercontrol"
        mc:Ignorable="d"
        Title="SignInForm" Height="500" Width="800" >
    <Window.Background>
        <ImageBrush ImageSource="/SignInPage_Matin/images/backGround2.jpg" Stretch="Fill"/>
    </Window.Background>
    <Grid>
        <Border BorderBrush="Black" Background="Black" Opacity="0.8" BorderThickness="1" HorizontalAlignment="Center" Height="390" Margin="10,60,0,55" VerticalAlignment="Top" Width="492">
            <StackPanel Margin="20,5,20,5">
               
                <Label Content="Sign In" FontWeight="Bold"  Foreground="White" Margin="0,0,0,30" FontSize="20"  HorizontalAlignment="Left" />
                <UserOb:UserControl1 IMGSource="/SignInPage_Matin/images/user.jpg"     Margin="0,0,0,20"            XWidth="30" Height="40"/>
                <StackPanel Orientation="Horizontal">
                    <UserOb:UserControl1 x:Name="mamad" IMGSource="/SignInPage_Matin/images/icons8-name-tag-64.jpg"  Margin="0,0,20,20"  Height="40"/>
                    <TextBox x:Name="txtBox" Grid.Column="1" FontSize="15" VerticalContentAlignment="Center" BorderBrush="AliceBlue" BorderThickness="2" Width="200" Margin="0,0,0,20"  Height="40"/>
                </StackPanel>
                <UserOb:UserControl1 IMGSource="/SignInPage_Matin/images/icons8-email-64.jpg"  Margin="0,0,0,20"    XWidth="30" Height="40"/>
                <UserOb:UserControl1 x:Name="Demo" IMGSource="/SignInPage_Matin/images/icons8-phone-64.jpg" Margin="0,0,0,20"     XWidth="30" Height="40"/>

                <Button Content="Signin" FontSize="15" Background="#FFCC00" Click="Button_Click" Width="100" Height="30"/>





            </StackPanel>
        </Border>


    </Grid>
</Window>
